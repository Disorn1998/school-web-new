# Root .gitignore for the School-Web Monorepo

# Ignore all .env files everywhere to prevent leaking secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node/Frontend ignores
node_modules/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Go/Backend ignores
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
go.work
go.work.sum

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
